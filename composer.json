{
    "name": "philmorehost/codevault",
    "description": "CodeVault — full WHMCS-parity billing platform, vanilla PHP",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "CodeVault\\": "core/"
        },
        "files": [
            "core/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "CodeVault\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
